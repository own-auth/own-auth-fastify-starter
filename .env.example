# Server-only Postgres database used by Own Auth.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/own_auth_starter

# Server-only. Generate with: openssl rand -base64 32
OWN_AUTH_TOKEN_PEPPER=replace-with-a-long-random-secret

# Browser origin used for cookies, CSRF validation, and email links.
OWN_AUTH_APP_URL=http://localhost:3000

# Server-only key created in the Own Auth Delivery dashboard.
OWN_AUTH_EMAIL_DELIVERY_KEY=oa_delivery_replace-with-your-key

# Fastify listens on 3001 in development; Vite proxies /api to it.
PORT=3001

# Reserved for automated tests. Never enable this in production.
# OWN_AUTH_TEST_MODE=1
